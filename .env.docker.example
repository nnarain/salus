# Docker Compose Environment Variables
# Copy this file to .env and update the values

############
# Database
############
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

############
# JWT Secret
############
# Generate a secure JWT secret (minimum 32 characters)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

############
# API Settings
############
# The URL where your Supabase API is accessible
API_EXTERNAL_URL=http://localhost:8000

# The URL of your application (for OAuth redirects, etc.)
SITE_URL=http://localhost:3000

# Additional redirect URLs (comma separated)
ADDITIONAL_REDIRECT_URLS=

############
# Auth Settings
############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

############
# Email/SMTP Settings
############
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=

############
# Mailer URL Paths
############
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# PostgREST
############
PGRST_DB_SCHEMAS=public

############
# Supabase Keys (these are example keys for local development)
############
# Anon key - used by the client-side application
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key - used for admin operations (keep this secret!)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

############
# Next.js App Settings
############
# These should point to your Kong gateway
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

############
# Image Proxy
############
IMGPROXY_ENABLE_WEBP_DETECTION=true
