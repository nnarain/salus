# Docker Compose Environment Variables
# Copy this file to .env and update the values

############
# Database
############
POSTGRES_PASSWORD=postgres

############
# JWT Secret
############
# This is the demo JWT secret used by default Supabase
# For production, generate a new one with: openssl rand -base64 32
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

############
# Supabase Keys (demo keys for local development)
############
# Anon key - used by the client-side application
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

############
# Next.js App Settings
############
# PostgREST API endpoint (exposed on port 3001)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

############
# PostgREST
############
PGRST_DB_SCHEMAS=public
