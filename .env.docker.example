# Optional: copy to .env to override the local defaults.
# Use a URL-safe password (letters, digits, '-' and '_').
# Generate one for your home server with: openssl rand -hex 24
POSTGRES_PASSWORD=postgres

# The app is private by default. Host Caddy can proxy to 127.0.0.1:3000.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Optional MCP server (docker compose --profile mcp up -d). Also private by default.
MCP_BIND_ADDRESS=127.0.0.1
MCP_PORT=8000
# Timezone the MCP server uses for "today" (e.g. America/Toronto).
TZ=UTC

# Used only with the development override; PostgreSQL binds to loopback.
POSTGRES_PORT=5432
